# Copy to .env (never commit .env) and fill in your values.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_campus_db
DB_USER=postgres
DB_PASSWORD=change-me

# Sessions end this many hours after sign-in
SESSION_HOURS=8

# Where the dashboard is served from: allowed for CORS and used as the
# WebAuthn origin. Comma-separate several origins; the first one is used
# for WebAuthn.
FRONTEND_ORIGIN=http://localhost:5173

# WebAuthn relying-party ID: the dashboard's host name, without scheme or
# port. Changing it invalidates fingerprints registered under the old one.
WEBAUTHN_RP_ID=localhost

# Camera: a webcam index (0, 1, ...) or a stream URL such as rtsp://...
CAMERA_SOURCE=0
# Name stored with each event (useful once there is more than one camera)
CAMERA_NAME=main
# Person detection input size (the camera picture itself is streamed at full
# size), and CPU threads for detection (PyTorch) and face recognition
# (TensorFlow). Defaults: 416, half and a quarter of the CPU's threads.
# DETECTION_IMAGE_SIZE=416
# DETECTION_THREADS=4
# RECOGNITION_THREADS=2

# Failed sign-ins: after this many for one account, it is locked for LOGIN_LOCKOUT_MINUTES
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Recognition events are deleted after this many days (whole number, 1 or more).
# They are attendance records linked to face recognition: keep them no longer than needed.
EVENT_RETENTION_DAYS=90
