# Copy to .env (never commit .env) and fill in your values.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_campus_db
DB_USER=postgres
DB_PASSWORD=change-me

# Sessions end this many hours after sign-in
SESSION_HOURS=8

# Where the dashboard is served from: allowed for CORS and used as the
# WebAuthn origin. Comma-separate several origins; the first one is used
# for WebAuthn.
FRONTEND_ORIGIN=http://localhost:5173

# WebAuthn relying-party ID: the dashboard's host name, without scheme or
# port. Changing it invalidates fingerprints registered under the old one.
WEBAUTHN_RP_ID=localhost

# Camera: a webcam index (0, 1, ...) or a stream URL such as rtsp://...
CAMERA_SOURCE=0
